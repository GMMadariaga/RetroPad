<Window x:Class="RetroPad.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroPad"
        Width="1280" Height="820"
        Background="#0A0A0A"
        Foreground="#AAAAAA"
        FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveFileAsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Global dark MenuItem style (applies to ALL MenuItems) -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,4" />
            <!-- Submenu template (used by top-level items with children) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       VerticalOffset="-1"
                                       Focusable="False"
                                       PopupAnimation="None">
                                    <Border Background="#111111"
                                            BorderBrush="#1A1A1A"
                                            BorderThickness="1"
                                            Padding="0,2">
                                        <ScrollViewer CanContentScroll="True"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A" />
                                <Setter Property="Foreground" Value="#00AA55" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161616" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Bd" Property="Background" Value="#111111" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Bd" Property="Background" Value="#111111" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#444444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-level menu items: transparent background, smaller padding -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#151515" BorderThickness="1">
        <DockPanel>
            <!-- ═══════════════════════════════════════ -->
            <!-- TITLE BAR                              -->
            <!-- ═══════════════════════════════════════ -->
            <Grid DockPanel.Dock="Top" Height="30" Background="#0E0E0E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="■" Foreground="#00AA55" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding WindowTitle}" Foreground="#555555"
                               FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Width="44" Height="30"
                            Background="Transparent" Foreground="#555555"
                            BorderThickness="0" FontSize="11"
                            Click="Minimize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1A1A1A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="□" Width="44" Height="30"
                            Background="Transparent" Foreground="#555555"
                            BorderThickness="0" FontSize="11"
                            Click="Maximize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1A1A1A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Width="44" Height="30"
                            Background="Transparent" Foreground="#555555"
                            BorderThickness="0" FontSize="11"
                            Click="Close_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                        <Setter Property="Foreground" Value="#AAAAAA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════ -->
            <!-- MENU BAR                               -->
            <!-- ═══════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#0E0E0E"
                    BorderBrush="#151515" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Menu Grid.Column="0" Background="Transparent"
                          VerticalAlignment="Center" Margin="4,0">
                    <MenuItem Header="_File" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewTabCommand}"
                                  />
                        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveFileCommand}"
                                  />
                        <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"
                                  />
                    </MenuItem>

                    <MenuItem Header="_Edit" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"
                                  />
                        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="Cut_Click"
                                  />
                        <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click"
                                  />
                        <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="Find_Click"
                                  />
                        <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" Click="Replace_Click"
                                  />
                        <MenuItem Header="_Go to Line..." InputGestureText="Ctrl+G" Click="GoToLine_Click"
                                  />
                        <Separator Background="#1A1A1A" Height="1" Margin="6,2" />
                        <MenuItem Header="Duplica_te Line" InputGestureText="Ctrl+D" Click="DuplicateLine_Click"
                                  />
                        <MenuItem Header="Dele_te Line" InputGestureText="Ctrl+Shift+K" Click="DeleteLine_Click"
                                  />
                        <MenuItem Header="Move Line _Up" InputGestureText="Alt+Up" Click="MoveLineUp_Click"
                                  />
                        <MenuItem Header="Move Line _Down" InputGestureText="Alt+Down" Click="MoveLineDown_Click"
                                  />
                    </MenuItem>

                    <MenuItem Header="F_ormat" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="_Format Document" InputGestureText="Ctrl+Shift+F"
                                  Command="{Binding FormatDocumentCommand}"
                                  />
                    </MenuItem>

                    <MenuItem Header="_Language" Style="{StaticResource TopMenuItem}"
                              ItemsSource="{Binding AvailableLanguages}" MaxHeight="350">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <EventSetter Event="Click" Handler="Language_Click" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    </Menu>

                    <TextBlock Grid.Column="1" Text="{Binding LanguageStatus}"
                               Foreground="#2A2A2A" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- STATUS BAR                             -->
            <!-- ═══════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#0A0A0A"
                    BorderBrush="#151515" BorderThickness="0,1,0,0">
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                               Foreground="#444444" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0" />

                    <Border Grid.Column="1" Background="#111111" Padding="8,0" Margin="0,0,1,0">
                        <TextBlock Text="{Binding LanguageStatus}" Foreground="#3A3A3A"
                                   FontSize="9" VerticalAlignment="Center" />
                    </Border>

                    <Border Grid.Column="2" Background="#111111" Padding="10,0" Margin="0,0,1,0">
                        <TextBlock Text="UTF-8" Foreground="#444444"
                                   FontSize="11" VerticalAlignment="Center" />
                    </Border>

                    <Border Grid.Column="3" Background="#111111" Padding="10,0">
                        <TextBlock Text="{Binding CursorStatus}" Foreground="#555555"
                                   FontSize="11" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- TABS + EDITOR                          -->
            <!-- ═══════════════════════════════════════ -->
            <DockPanel>
                <!-- Tab strip (headers only, no ContentTemplate) -->
                <Border DockPanel.Dock="Top" Background="#0A0A0A"
                        BorderBrush="#151515" BorderThickness="0,0,0,1">
                    <TabControl x:Name="TabContainer"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                SelectionChanged="TabContainer_SelectionChanged">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#0A0A0A" />
                                <Setter Property="Foreground" Value="#444444" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="MinWidth" Value="100" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="#151515"
                                                    BorderThickness="0,0,1,0"
                                                    Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="headerText"
                                                               Grid.Column="0"
                                                               Text="{Binding Header}"
                                                               FontSize="12"
                                                               Foreground="#444444"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,6,0"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="×"
                                                               FontSize="13"
                                                               Foreground="#2A2A2A"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               Cursor="Hand"
                                                               MouseLeftButtonDown="CloseTab_Click" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#111111" />
                                                    <Setter TargetName="headerText" Property="Foreground" Value="#AAAAAA" />
                                                    <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#00AA55" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#111111" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Hide the content area of each TabItem -->
                                <Setter Property="ContentTemplate" Value="{x:Null}" />
                                <Setter Property="ContentTemplateSelector" Value="{x:Null}" />
                            </Style>
                        </TabControl.ItemContainerStyle>
                    </TabControl>
                </Border>

                <!-- Editor host: one TextEditor per tab, swapped manually -->
                <Border x:Name="EditorHost" Background="#0A0A0A" />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
