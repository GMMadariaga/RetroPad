<Window x:Class="RetroPad.UI.Views.GoToLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Line"
        Width="300" Height="130"
        Background="#0A0A0A"
        Foreground="#AAAAAA"
        FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New"
        FontSize="12"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Line:" Width="45" VerticalAlignment="Center" Foreground="#555555" />
            <TextBox x:Name="LineInput"
                     Text="{Binding LineNumberText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#111111" Foreground="#AAAAAA" BorderBrush="#1E1E1E"
                     CaretBrush="#AAAAAA" SelectionBrush="#264F78"
                     Padding="4,2" FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New"
                     KeyDown="LineInput_KeyDown" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding MaxLineText}"
                   Foreground="#444444" Margin="0,0,0,6" />

        <WrapPanel Grid.Row="2">
            <Button Content="Go" Click="Go_Click" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00AA55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Click="Cancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}"
                   Foreground="#CC3333" VerticalAlignment="Bottom" />
    </Grid>
</Window>
