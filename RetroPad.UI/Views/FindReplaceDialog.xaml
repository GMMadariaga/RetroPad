<Window x:Class="RetroPad.UI.Views.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find and Replace"
        Width="460" Height="240"
        Background="#0A0A0A"
        Foreground="#AAAAAA"
        FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New"
        FontSize="12"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Find:" Width="60" VerticalAlignment="Center" Foreground="#555555" />
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#111111" Foreground="#AAAAAA" BorderBrush="#1E1E1E"
                     CaretBrush="#AAAAAA" SelectionBrush="#264F78"
                     Padding="4,2" FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Replace:" Width="60" VerticalAlignment="Center" Foreground="#555555" />
            <TextBox x:Name="ReplaceBox"
                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#111111" Foreground="#AAAAAA" BorderBrush="#1E1E1E"
                     CaretBrush="#AAAAAA" SelectionBrush="#264F78"
                     Padding="4,2" FontFamily="Cascadia Mono, Consolas, JetBrains Mono, Courier New" />
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox Content="Match Case" IsChecked="{Binding MatchCase}"
                      Foreground="#555555" Margin="0,0,12,0" />
            <CheckBox Content="Whole Word" IsChecked="{Binding WholeWord}"
                      Foreground="#555555" Margin="0,0,12,0" />
            <CheckBox Content="Regex" IsChecked="{Binding UseRegex}"
                      Foreground="#555555" />
        </StackPanel>

        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
            <Button Content="Find Next" Click="FindNext_Click" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00AA55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Replace" Click="Replace_Click" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00AA55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Replace All" Click="ReplaceAll_Click" Margin="0,0,6,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00AA55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Close" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#161616" BorderBrush="#1E1E1E"
                                BorderThickness="1" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}"
                   Foreground="#444444" VerticalAlignment="Bottom" />
    </Grid>
</Window>
